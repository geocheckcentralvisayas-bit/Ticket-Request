# Server (non-sensitive)
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DB_PATH=./data/envis.db

# SMTP transport (non-sensitive)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ---------------------------------------------------------------------------
# Secrets are NOT stored in this file.
# Run `npm run secrets:setup --workspace=backend` to enter JWT keys, SMTP
# credentials, and notification addresses. They are encrypted with AES-256-GCM
# and saved outside the repository, in the current user's profile directory.
#
# In production you may instead inject real environment variables:
#   JWT_SECRET, JWT_REFRESH_SECRET, SMTP_USER, SMTP_PASS, SMTP_FROM,
#   NOTIFICATION_EMAILS
# ---------------------------------------------------------------------------
