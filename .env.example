# ENVIS Ticket Request & Account Handler Manager
# Copy this file to backend/.env for local development.
# It contains non-sensitive configuration only.

# Server
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DB_PATH=./data/envis.db

# SMTP transport (non-sensitive)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Set this only when running behind a trusted reverse proxy.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Secrets are NOT stored in this file.
# Run `npm run secrets:setup --workspace=backend` to enter the JWT signing keys,
# SMTP credentials, sender address, and notification recipients. They are
# encrypted with AES-256-GCM and saved outside the repository in the current
# user's profile directory. Real environment variables take precedence.
# ---------------------------------------------------------------------------

# Optional account seeding (only applies to brand-new accounts).
# If unset, the seeder generates random passwords into data/initial-credentials.txt.
# SEED_DEFAULT_PASSWORD=
# SEED_PASSWORD_RD_REGIONAL=
